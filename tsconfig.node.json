{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "tests/**/*", "rules/*.json", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/core/**/*", "src/web/sqljsDatabase.ts"]
}
